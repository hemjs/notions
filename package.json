{
  "name": "@hemjs/notions",
  "version": "2.0.0",
  "description": "Utilities for arrays, objects, strings, and more",
  "author": "Augustus Kamau",
  "license": "MIT",
  "keywords": [
    "hemjs",
    "notions",
    "utilities"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build:copy-misc": "node ./scripts/copy-misc.js",
    "build": "tsc -p tsconfig.build.json && npm run build:copy-misc",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prerelease": "npm run prebuild && npm run build",
    "release": "release-it",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "release-it": "21.0.2",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "homepage": "https://github.com/hemjs/notions#readme",
  "bugs": {
    "url": "https://github.com/hemjs/notions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemjs/notions.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
